<?xml version="1.0" encoding="utf-8"?>
<!-- Petit widget « Reprendre » : la dernière vidéo, affiche en grand. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade" />
    <ImageView
        android:id="@+id/resume_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/widget_play_bg"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_play" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/resume_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFB86B"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/resume_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/resume_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="#FFFFB86B"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
