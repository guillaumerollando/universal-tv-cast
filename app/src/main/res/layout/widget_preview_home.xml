<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de l'accueil : la vidéo à reprendre, puis les dernières chaînes. Rempli par HomeWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/resume"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="96dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_thumb"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_sample_poster" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/resume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_resume"
                android:textColor="#FFFFB86B"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resume_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_sample_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resume_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_sub"
                android:textColor="#FFA9B2B5"
                android:textSize="12sp" />
            <ProgressBar
                android:id="@+id/resume_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progress="420"
                android:progressTint="#FFFFB86B"
                android:progressBackgroundTint="#55FFFFFF"
                android:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:id="@+id/resume_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/home_resume"
            android:padding="11dp"
            android:src="@drawable/ic_widget_play" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channels"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/ch0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            
            android:background="@drawable/widget_sample_ch1">
            <TextView
                android:id="@+id/ch0_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/ch0_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ch1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_sample_ch2">
            <TextView
                android:id="@+id/ch1_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/ch1_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ch2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_sample_ch3">
            <TextView
                android:id="@+id/ch2_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/ch2_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ch3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_sample_ch4">
            <TextView
                android:id="@+id/ch3_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/ch3_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
