<?xml version="1.0" encoding="utf-8"?>
<!-- « Reprendre + sites » : la vidéo à reprendre, puis les sites favoris. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/resume"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="96dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_thumb"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_sample_poster" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/resume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_resume"
                android:textColor="#FFFFB86B"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resume_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_sample_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resume_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_sub"
                android:textColor="#FFA9B2B5"
                android:textSize="12sp" />
            <ProgressBar
                android:id="@+id/resume_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progress="420"
                android:progressTint="#FFFFB86B"
                android:progressBackgroundTint="#55FFFFFF"
                android:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:id="@+id/resume_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/home_resume"
            android:padding="11dp"
            android:src="@drawable/ic_widget_play" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sites"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/site0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            
            android:background="@drawable/widget_tile"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:id="@+id/site0_icon"
                android:src="@drawable/ic_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/site0_name"
                android:text="Archive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/site1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tile"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:id="@+id/site1_icon"
                android:src="@drawable/ic_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/site1_name"
                android:text="Blender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/site2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tile"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:id="@+id/site2_icon"
                android:src="@drawable/ic_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/site2_name"
                android:text="Commons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/site3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tile"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:id="@+id/site3_icon"
                android:src="@drawable/ic_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/site3_name"
                android:text="PeerTube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE6E9EA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
