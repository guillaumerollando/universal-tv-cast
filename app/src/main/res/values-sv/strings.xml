    <string name="tip_source_body">%1$s skickar videon till tv:n från din telefon. Om Android försätter appen i viloläge i bakgrunden fryser tv:n så fort du spolar framåt.</string>
    <string name="tip_self_title">Håll %1$s vaken under uppspelning</string>
