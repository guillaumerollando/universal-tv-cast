    <string name="tip_source_title">Keep %1$s awake for smooth seeking</string>
    <string name="tip_source_body">%1$s sends the video to the TV from your phone. If Android puts it to sleep in the background, the TV freezes as soon as you skip ahead.</string>
    <string name="tip_self_title">Keep %1$s awake during playback</string>
    <string name="tip_self_body">%1$s relays the video to the TV. If Android puts it to sleep, playback stops when the screen turns off.</string>
    <string name="tip_howto_xiaomi">In its settings: Battery saver → “No restrictions”, and turn on “Autostart”.</string>
    <string name="tip_howto_samsung">In its settings: Battery → “Unrestricted”.</string>
    <string name="tip_howto_huawei">In its settings: Battery → App launch → manage manually and allow running in background.</string>
    <string name="tip_howto_oppo">In its settings: Battery usage → allow background activity.</string>
    <string name="tip_howto_generic">In its settings: Battery → “Unrestricted” (or “Don’t optimize”).</string>
