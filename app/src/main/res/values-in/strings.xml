    <string name="tip_self_title">Biarkan %1$s tetap aktif selama pemutaran</string>
    <string name="tip_self_body">%1$s meneruskan video ke TV. Jika Android menidurkannya, pemutaran berhenti saat layar mati.</string>
    <string name="tip_howto_xiaomi">Di pengaturannya: Penghemat baterai → “Tanpa batasan”, lalu aktifkan “Mulai otomatis”.</string>
    <string name="tip_howto_samsung">Di pengaturannya: Baterai → “Tidak dibatasi”.</string>
    <string name="tip_howto_huawei">Di pengaturannya: Baterai → Peluncuran aplikasi → kelola secara manual dan izinkan berjalan di latar belakang.</string>
    <string name="tip_howto_oppo">Di pengaturannya: Penggunaan baterai → izinkan aktivitas latar belakang.</string>
